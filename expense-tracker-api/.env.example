# Illustrative values only. Copy to .env and replace before starting Docker.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/expense_tracker
SPRING_DATASOURCE_USERNAME=expense_tracker
SPRING_DATASOURCE_PASSWORD=replace-with-a-unique-app-password
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_tracker
# Keep MYSQL_PASSWORD equal to SPRING_DATASOURCE_PASSWORD for a new database.
MYSQL_PASSWORD=replace-with-a-unique-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# Generate Base64 from at least 32 random bytes; see README PowerShell example.
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
JWT_EXPIRATION_SECONDS=3600
